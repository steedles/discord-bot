# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env

# --- Required ---
# Discord Developer Portal → Bot → Reset Token
DISCORD_TOKEN=
# Discord Developer Portal → General Information → Application ID
DISCORD_CLIENT_ID=

# Leave blank for global slash-command registration.
# Set a server id while developing so commands update immediately.
DISCORD_GUILD_ID=

# --- Database ---
# docker compose -f docker-compose.dev.yml up -d
MONGO_URI=mongodb://127.0.0.1:27020
MONGO_DB=discord_bot

# --- Process ---
NODE_ENV=development
LOG_LEVEL=info
# Empty disables file logging. Stdout is always on.
LOG_DIR=

# --- Dashboard (all three required or the dashboard refuses to start) ---
DASHBOARD_ENABLED=true
DASHBOARD_PORT=4300
DASHBOARD_HOST=0.0.0.0
# Must match an OAuth2 redirect: <DASHBOARD_URL>/auth/callback
DASHBOARD_URL=http://localhost:4300
# Discord Developer Portal → OAuth2 → Client Secret
DISCORD_CLIENT_SECRET=
# Any long random string. Signs session cookies.
SESSION_SECRET=
SESSION_DAYS=7
# email:scrypt$salt$hash entries from `pnpm dashboard:hash`. Empty disables password login.
DASHBOARD_USERS=

# --- Polling ---
PRICE_POLL_SECONDS=60
LAUNCH_POLL_SECONDS=45
TRACK_POLL_SECONDS=60
MONITOR_ENABLED=true
MONITOR_POLL_SECONDS=60
MONITOR_MAX_TOKENS=120
# Channel id for provider-outage notices. Empty disables them.
MONITOR_STATUS_CHANNEL_ID=

ENABLE_PUMPPORTAL=true
ENABLE_RUG_SIGNATURE_CHECK=true
# Token Brief needs this, and the Message Content intent in the developer portal.
ENABLE_MESSAGE_CONTENT=true
PUMPPORTAL_WS=wss://pumpportal.fun/api/data

# --- Solana (optional) ---
HELIUS_API_KEY=
SOLANA_RPC_URL=
SOLANA_WS_URL=
SOLANA_RPC_CALLS_PER_MINUTE=60
HELIUS_WEBHOOK_SECRET=
HELIUS_WEBHOOK_URL=

# --- EVM RPC (optional; blank skips whale detection on that chain) ---
ETHEREUM_RPC_URL=
ETHEREUM_WS_URL=
BSC_RPC_URL=
BSC_WS_URL=
BASE_RPC_URL=
BASE_WS_URL=
ROBINHOOD_RPC_URL=
ROBINHOOD_WS_URL=

# --- Optional integrations (blank means off) ---
SIGNAL_INTAKE_URL=
SIGNAL_INTAKE_TOKEN=
SIGNAL_INTAKE_SOURCE=fomo-scanner
SIGNAL_INTAKE_CHAINS=solana

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

FOMO_ENABLED=false
FOMO_INGEST_SECRET=
FOMO_MAX_EVENT_AGE_MIN=10
FOMO_STALE_MIN=60
FOMO_ALERT_TELEGRAM_CHAT=
FOMO_MIN_USD=0
# Credential: anyone with this URL can post to that channel.
FOMO_WEBHOOK_URL=
FOMO_WEBHOOK_NAME=Fomo Alerts

OPS_RUNNER_SECRET=

# Public addresses only. Never put a private key or seed phrase here.
HOLDINGS_SOLANA_WALLET=
HOLDINGS_EVM_WALLET=
HOLDINGS_EVM_CHAINS=ethereum,base,robinhood
