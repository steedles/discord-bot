# Cloudflared ingress for the steedlescrypto named tunnel, matching the existing
# dohbelisk.com per-app tunnel pattern. deploy.sh renders the real config.yml
# from this template - filling TUNNEL_ID and SUBDOMAIN - and ships it plus the
# tunnel credentials JSON into deploy/homelab/cloudflared/ on the homelab, where
# the cloudflared container mounts them read-only.
#
# DO NOT commit the rendered config.yml or the <id>.json credentials (gitignored).

tunnel: __TUNNEL_ID__
credentials-file: /etc/cloudflared/__TUNNEL_ID__.json

ingress:
  - hostname: __SUBDOMAIN__
    service: http://bot:__DASHBOARD_PORT__

  # The Fomo login desktop is deliberately NOT routed here.
  #
  # It was, briefly. What answers on it is a browser holding a live Google
  # session with a route into the LAN, and putting that on a public hostname
  # means the only thing between the internet and the homelab is however well
  # the access policy in front of it was configured. Tailscale removes the
  # public door entirely rather than guarding it: the container binds to
  # loopback and `tailscale serve` publishes it to the tailnet only, so it is
  # reachable from anywhere you are logged into Tailscale and from nowhere else.
  #
  # See deploy/homelab/fomo-login/README.md.

  - service: http_status:404
