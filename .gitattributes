# This repo is edited on Windows and executed on Linux (the homelab).
# Everything the homelab runs must arrive as LF: a shell script checked out with
# CRLF fails there with "bad interpreter: /bin/bash^M". Pin it here so correctness
# does not depend on each machine's core.autocrlf setting.
* text=auto eol=lf

*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
Dockerfile* text eol=lf

*.png  binary
*.jpg  binary
*.gz   binary
*.tgz  binary
